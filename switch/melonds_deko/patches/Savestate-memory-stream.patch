+// A state kept in memory rather than in a file -- a frontend's save states
+// and rewind, say -- is written and read here directly, rather than through
+// stdio: the 3D engine alone is tens of thousands of small fields, and a
+// stdio call each, locking and all, made saving a state take over 20 ms on a
+// Switch, long enough to drop frames. A frontend that keeps its states in a
+// buffer opens the FILE it hands Savestate as it likes, then tells this about
+// that FILE and the buffer behind it with SavestateUseMemory().
+static FILE* MemoryFile = nullptr;
+static u8* MemoryData = nullptr;
+static u32 MemoryCapacity = 0, MemorySize = 0, MemoryPos = 0;
+static bool MemoryFailed = false;
+
+void SavestateUseMemory(FILE* f, u8* data, u32 capacity, u32 size)
+{
+    MemoryFile = f;
+    MemoryData = data;
+    MemoryCapacity = capacity;
+    MemorySize = size;
+    MemoryPos = 0;
+    MemoryFailed = false;
+}
+
+static bool StateMemoryReach(u32 end)
+{
+    if (end > MemoryCapacity)
+    {
+        MemoryFailed = true;
+        return false;
+    }
+    // Whatever a seek forward skipped over reads back as zeros, as a file's
+    // would.
+    if (end > MemorySize)
+    {
+        memset(MemoryData + MemorySize, 0, end - MemorySize);
+        MemorySize = end;
+    }
+    return true;
+}
+
+static size_t StateWrite(const void* data, size_t len, FILE* f)
+{
+    if (f != MemoryFile) return fwrite(data, len, 1, f);
+    if (!StateMemoryReach(MemoryPos + (u32)len)) return 0;
+    memcpy(MemoryData + MemoryPos, data, len);
+    MemoryPos += (u32)len;
+    return 1;
+}
+
+static size_t StateRead(void* data, size_t len, FILE* f)
+{
+    if (f != MemoryFile) return fread(data, len, 1, f);
+    if (MemoryPos + len > MemorySize) return 0;
+    memcpy(data, MemoryData + MemoryPos, len);
+    MemoryPos += (u32)len;
+    return 1;
+}
+
+static long StateTell(FILE* f)
+{
+    if (f != MemoryFile) return ftell(f);
+    return MemoryPos;
+}
+
+static int StateSeek(FILE* f, long offset, int whence)
+{
+    if (f != MemoryFile) return fseek(f, offset, whence);
+    long base = whence == SEEK_SET ? 0 : whence == SEEK_CUR ? (long)MemoryPos : (long)MemorySize;
+    long pos = base + offset;
+    if (pos < 0 || (u32)pos > MemoryCapacity) return -1;
+    MemoryPos = (u32)pos;
+    return 0;
+}
